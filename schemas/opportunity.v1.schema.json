{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar.wp.org.nz/schemas/opportunity.v1.schema.json",
  "title": "WP Core Radar opportunity.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "opportunityKey",
    "opportunityRevision",
    "ticket",
    "discovery",
    "ranking",
    "radar_state",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "opportunity.v1"
    },
    "version": {
      "const": 1
    },
    "opportunityKey": {
      "type": "string",
      "pattern": "^core-trac:[0-9]+$"
    },
    "opportunityRevision": {
      "type": "string",
      "pattern": "^opportunity-revision-v1-[0-9a-f]{32}$"
    },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "summary",
        "component",
        "status",
        "resolution",
        "owner",
        "reporter",
        "type",
        "priority",
        "milestone",
        "wordpress_version",
        "keywords",
        "created",
        "modified",
        "comment_count"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "[0-9]+"
        },
        "url": {
          "type": "string",
          "pattern": "https://core\\.trac\\.wordpress\\.org/ticket/[0-9]+"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "component": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolution": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "reporter": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": [
            "string",
            "null"
          ]
        },
        "priority": {
          "type": [
            "string",
            "null"
          ]
        },
        "milestone": {
          "type": [
            "string",
            "null"
          ]
        },
        "wordpress_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "created": {
          "type": [
            "string",
            "null"
          ]
        },
        "modified": {
          "type": [
            "string",
            "null"
          ]
        },
        "comment_count": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "tracks"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "query_slug",
              "source_identity",
              "artifact_path",
              "track"
            ],
            "properties": {
              "query_slug": {
                "type": "string"
              },
              "source_identity": {
                "type": "string"
              },
              "artifact_path": {
                "type": "string"
              },
              "track": {
                "type": "string"
              }
            }
          }
        },
        "tracks": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "tier",
        "tier_label",
        "scoring_version",
        "reasons",
        "breakdown",
        "complexity_markers"
      ],
      "properties": {
        "score": {
          "type": "integer"
        },
        "tier": {
          "type": "string"
        },
        "tier_label": {
          "type": "string"
        },
        "scoring_version": {
          "type": "string"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "breakdown": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "signal",
              "points"
            ],
            "properties": {
              "signal": {
                "type": "string"
              },
              "points": {
                "type": "integer"
              }
            }
          }
        },
        "complexity_markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "radar_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string"
        },
        "received_props": {
          "type": "boolean"
        },
        "props_recorded_at": {
          "type": "string"
        },
        "changeset": {
          "type": "string"
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_class",
        "expected_contribution_type",
        "contribution_hypothesis",
        "recommendedContributionClass",
        "confidence",
        "reason",
        "evidenceFreshness",
        "source_coverage",
        "required_evidence_profiles",
        "visual_evidence",
        "relevant_skills",
        "upstream_freshness",
        "duplication_risk",
        "likely_hwp_channel",
        "engineering_weight",
        "eligibility",
        "supply_quality"
      ],
      "properties": {
        "opportunity_class": {
          "type": "string",
          "enum": [
            "needs-testing-verification",
            "regression-test-only",
            "browser-ui-testing",
            "responsive-mobile-testing",
            "accessibility-testing",
            "documentation-review",
            "unit-test-review",
            "bounded-needs-patch",
            "stale-patch-refresh",
            "php-runtime-compatibility",
            "build-tooling",
            "performance-validation",
            "failing-fragile-test-reproduction",
            "maintainer-requested-reproduction",
            "dev-feedback-review",
            "meaningful-good-first-bug",
            "recent-patch-verification",
            "scoped-investigation"
          ]
        },
        "expected_contribution_type": {
          "type": "string"
        },
        "contribution_hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "recommendedContributionClass": {
          "type": "string",
          "enum": [
            "TEST_EXISTING_PR",
            "ADD_REGRESSION_TEST",
            "REPRODUCE_BUG",
            "VERIFY_EXISTING_PATCH",
            "REVIEW_EXISTING_PR",
            "REVIEW_API_EDGE_CASE",
            "BENCHMARK_PERFORMANCE_CHANGE",
            "VERIFY_PHP_COMPATIBILITY",
            "ACCESSIBILITY_UI_VERIFY",
            "DOCUMENT_TECHNICAL_BEHAVIOR",
            "FOLLOW_UP_AFTER_UPSTREAM_CHANGE",
            "STALE_BUT_ACTIONABLE",
            "NO_CLEAR_CONTRIBUTION"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidenceFreshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "modifiedAt",
            "ageDays"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "fresh",
                "recent",
                "stale",
                "unknown"
              ]
            },
            "modifiedAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "ageDays": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "source_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "trac_ticket",
            "trac_keywords_status_component",
            "public_patch_or_attachment",
            "wordpress_develop_pr",
            "public_pr_discussion_or_review",
            "changed_files_or_diff",
            "public_test_or_ci_evidence",
            "related_or_referenced_ticket"
          ],
          "properties": {
            "trac_ticket": {
              "type": "boolean"
            },
            "trac_keywords_status_component": {
              "type": "boolean"
            },
            "public_patch_or_attachment": {
              "type": "boolean"
            },
            "wordpress_develop_pr": {
              "type": "boolean"
            },
            "public_pr_discussion_or_review": {
              "type": "boolean"
            },
            "changed_files_or_diff": {
              "type": "boolean"
            },
            "public_test_or_ci_evidence": {
              "type": "boolean"
            },
            "related_or_referenced_ticket": {
              "type": "boolean"
            }
          }
        },
        "required_evidence_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "visual_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relevance",
            "reason"
          ],
          "properties": {
            "relevance": {
              "type": "string",
              "enum": [
                "required",
                "useful",
                "not-relevant"
              ]
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "relevant_skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "upstream_freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "modified_at",
            "age_days"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "fresh",
                "recent",
                "stale",
                "unknown"
              ]
            },
            "modified_at": {
              "type": [
                "string",
                "null"
              ]
            },
            "age_days": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        },
        "duplication_risk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "level",
            "reasons"
          ],
          "properties": {
            "level": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "unknown"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "likely_hwp_channel": {
          "type": "string",
          "enum": [
            "core-trac-comment",
            "github-review",
            "core-trac-attachment"
          ]
        },
        "engineering_weight": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "eligibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "blockers"
          ],
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "eligible",
                "requires-upstream-validation",
                "blocked"
              ]
            },
            "blockers": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        },
        "supply_quality": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "current_ticket_state_required",
            "fresh_upstream_read_required",
            "nonduplication_check_required",
            "current_patch_identity_required",
            "missing_patch_head_base",
            "screenshot_candidate",
            "backend_only_candidate"
          ],
          "properties": {
            "current_ticket_state_required": {
              "type": "boolean"
            },
            "fresh_upstream_read_required": {
              "type": "boolean"
            },
            "nonduplication_check_required": {
              "type": "boolean"
            },
            "current_patch_identity_required": {
              "type": "boolean"
            },
            "missing_patch_head_base": {
              "type": "boolean"
            },
            "screenshot_candidate": {
              "type": "boolean"
            },
            "backend_only_candidate": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "collection_id",
        "snapshot_id"
      ],
      "properties": {
        "collection_id": {
          "type": "string",
          "pattern": "collection-v1-[0-9a-f]{24}"
        },
        "snapshot_id": {
          "type": "string",
          "pattern": "snapshot-v1-[0-9a-f]{24}"
        }
      }
    }
  }
}

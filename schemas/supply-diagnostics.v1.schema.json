{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar.wp.org.nz/schemas/supply-diagnostics.v1.schema.json",
  "title": "WP Core Radar supply-diagnostics.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "collection_id",
    "snapshot_id",
    "opportunity_count",
    "query_rows",
    "qualified_candidates_by_class",
    "recommended_contribution_classes",
    "recommended_contribution_confidence",
    "rejected_candidates_by_reason",
    "stale_candidates_by_class",
    "duplicate_candidates_by_risk",
    "missing_reproducible_environments_by_class",
    "missing_patch_head_base_by_class",
    "already_satisfied_count",
    "screenshot_suitable_count",
    "backend_only_evidence_count",
    "candidate_aging",
    "bottleneck_by_lifecycle_stage"
  ],
  "properties": {
    "schema": {"const": "supply-diagnostics.v1"},
    "version": {"const": 1},
    "collection_id": {"type": "string", "pattern": "^collection-v1-[0-9a-f]{24}$"},
    "snapshot_id": {"type": "string", "pattern": "^snapshot-v1-[0-9a-f]{24}$"},
    "opportunity_count": {"type": "integer"},
    "query_rows": {
      "type": "object",
      "additionalProperties": {"type": "integer"}
    },
    "qualified_candidates_by_class": {
      "type": "array",
      "items": {"$ref": "#/$defs/countPair"}
    },
    "recommended_contribution_classes": {
      "type": "array",
      "items": {"$ref": "#/$defs/countPair"}
    },
    "recommended_contribution_confidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/countPair"}
    },
    "rejected_candidates_by_reason": {
      "type": "array",
      "items": {"$ref": "#/$defs/countPair"}
    },
    "stale_candidates_by_class": {
      "type": "array",
      "items": {"$ref": "#/$defs/countPair"}
    },
    "duplicate_candidates_by_risk": {
      "type": "array",
      "items": {"$ref": "#/$defs/countPair"}
    },
    "missing_reproducible_environments_by_class": {
      "type": "array",
      "items": {"$ref": "#/$defs/countPair"}
    },
    "missing_patch_head_base_by_class": {
      "type": "array",
      "items": {"$ref": "#/$defs/countPair"}
    },
    "already_satisfied_count": {"type": "integer"},
    "screenshot_suitable_count": {"type": "integer"},
    "backend_only_evidence_count": {"type": "integer"},
    "candidate_aging": {
      "type": "array",
      "items": {"$ref": "#/$defs/countPair"}
    },
    "bottleneck_by_lifecycle_stage": {
      "type": "array",
      "items": {"$ref": "#/$defs/countPair"}
    }
  },
  "$defs": {
    "countPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "count"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "count": {"type": "integer"}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar.wp.org.nz/schemas/execution-result.v1.schema.json",
  "title": "WP Core Radar execution-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "operation", "status", "started_at", "completed_at", "reference_time", "input_identities", "output_identities", "artifacts", "warnings", "errors", "retry_safe"],
  "properties": {
    "schema": {"const": "execution-result.v1"}, "version": {"const": 1},
    "operation": {"enum": ["certify", "verify"]},
    "status": {"enum": ["success", "failure"]},
    "started_at": {"type": "string"}, "completed_at": {"type": "string"}, "reference_time": {"type": "string"},
    "input_identities": {"type": "array", "items": {"type": "string"}},
    "output_identities": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "[0-9a-f]{64}"}}}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "retry_safe": {"type": "boolean"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar.wp.org.nz/schemas/collection.v1.schema.json",
  "title": "WP Core Radar collection.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "collection_id", "reference_time", "state", "expected_queries", "query_evidence", "unexpected_artifacts", "ambiguous_artifacts", "warnings", "errors"],
  "properties": {
    "schema": {"const": "collection.v1"},
    "version": {"const": 1},
    "collection_id": {"type": "string", "pattern": "collection-v1-[0-9a-f]{24}"},
    "reference_time": {"type": "string", "minLength": 19},
    "state": {"enum": ["complete", "incomplete", "failed"]},
    "expected_queries": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "query_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query_slug", "source_identity", "artifact_path", "collected_at", "exists", "valid_csv", "recognized_ticket_id", "row_count", "sha256", "warnings", "errors"],
        "properties": {
          "query_slug": {"type": "string", "minLength": 1},
          "source_identity": {"type": "string", "minLength": 1},
          "artifact_path": {"type": "string", "minLength": 1},
          "collected_at": {"type": ["string", "null"]},
          "exists": {"type": "boolean"},
          "valid_csv": {"type": "boolean"},
          "recognized_ticket_id": {"type": "boolean"},
          "row_count": {"type": "integer"},
          "sha256": {"type": "string", "pattern": "[0-9a-f]{64}|"},
          "warnings": {"type": "array", "items": {"type": "string"}},
          "errors": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "unexpected_artifacts": {"type": "array", "items": {"type": "string"}},
    "ambiguous_artifacts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["query_slug", "artifact_paths"],
        "properties": {
          "query_slug": {"type": "string"},
          "artifact_paths": {"type": "array", "items": {"type": "string"}, "minItems": 2}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar.wp.org.nz/schemas/contribution-state.v1.schema.json",
  "title": "WP Core Radar contribution-state.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "contributions"],
  "properties": {
    "schema": {"const": "contribution-state.v1"},
    "version": {"const": 1},
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticket_id",
          "opportunityKey",
          "lifecycle_state",
          "contributionType",
          "public_url",
          "testedHeadSha",
          "testedBaseSha",
          "verifiedAt",
          "status",
          "summary",
          "reason",
          "updated_at",
          "received_props"
        ],
        "properties": {
          "ticket_id": {"type": "string", "pattern": "^[0-9]+$"},
          "opportunityKey": {"type": "string", "pattern": "^core-trac:[0-9]+$"},
          "lifecycle_state": {"enum": ["PUBLIC_DELIVERY_VERIFIED", "UPSTREAM_ACCEPTED", "FOLLOWUP_REQUIRED"]},
          "contributionType": {
            "enum": [
              "NEW_FINDING",
              "INDEPENDENT_CONFIRMATION",
              "EXTENDED_EVIDENCE",
              "RETEST_CONFIRMATION"
            ]
          },
          "public_url": {"type": "string", "pattern": "^https://(core\\.trac\\.wordpress\\.org|github\\.com)/.+$"},
          "tested_sha": {"type": "string", "pattern": "^([0-9a-f]{40})?$"},
          "testedHeadSha": {"type": "string", "pattern": "^([0-9a-f]{40})?$"},
          "testedBaseSha": {"type": "string", "pattern": "^([0-9a-f]{40})?$"},
          "verifiedAt": {"type": "string", "minLength": 19},
          "status": {"type": "string"},
          "summary": {"type": "string"},
          "reason": {"type": "string"},
          "updated_at": {"type": "string", "minLength": 19},
          "received_props": {"type": "boolean"},
          "props_observed_at": {"type": "string"},
          "changeset": {"type": "string", "pattern": "^[0-9]*$"}
        }
      }
    }
  }
}

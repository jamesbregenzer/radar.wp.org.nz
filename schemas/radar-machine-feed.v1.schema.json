{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar.wp.org.nz/schemas/radar-machine-feed.v1.schema.json",
  "title": "WP Core Radar machine-feed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "snapshot", "opportunities", "verifiedContributions"],
  "properties": {
    "schema": {"const": "radar-machine-feed.v1"},
    "version": {"const": 1},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "collection_id",
        "dataset_sha256",
        "reference_time",
        "source_revision",
        "scoring_version",
        "opportunity_count"
      ],
      "properties": {
        "snapshot_id": {"type": "string", "pattern": "^snapshot-v1-[0-9a-f]{24}$"},
        "collection_id": {"type": "string", "pattern": "^collection-v1-[0-9a-f]{24}$"},
        "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reference_time": {"type": "string", "minLength": 19},
        "source_revision": {"type": ["string", "null"]},
        "scoring_version": {"type": "string"},
        "opportunity_count": {"type": "integer"}
      }
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticketId", "opportunityKey", "opportunityRevision", "rank", "tier", "score"],
        "properties": {
          "ticketId": {"type": "string", "pattern": "^[0-9]+$"},
          "opportunityKey": {"type": "string", "pattern": "^core-trac:[0-9]+$"},
          "opportunityRevision": {"type": "string", "pattern": "^opportunity-revision-v1-[0-9a-f]{32}$"},
          "rank": {"type": "integer"},
          "tier": {"type": "string"},
          "score": {"type": "integer"},
          "qualification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["opportunityClass", "recommendedContributionClass", "confidence", "reason", "evidenceFreshness", "sourceCoverage", "expectedContributionType", "contributionHypothesis", "requiredEvidenceProfiles", "visualEvidenceRelevance", "relevantSkills", "upstreamFreshness", "duplicationRisk", "likelyHwpChannel", "engineeringWeight", "screenshotCandidate", "backendOnlyCandidate", "missingPatchHeadBase", "eligibilityState", "blockers"],
            "properties": {
              "opportunityClass": {"type": "string"},
              "recommendedContributionClass": {
                "type": "string",
                "enum": [
                  "TEST_EXISTING_PR",
                  "ADD_REGRESSION_TEST",
                  "REPRODUCE_BUG",
                  "VERIFY_EXISTING_PATCH",
                  "REVIEW_EXISTING_PR",
                  "REVIEW_API_EDGE_CASE",
                  "BENCHMARK_PERFORMANCE_CHANGE",
                  "VERIFY_PHP_COMPATIBILITY",
                  "ACCESSIBILITY_UI_VERIFY",
                  "DOCUMENT_TECHNICAL_BEHAVIOR",
                  "FOLLOW_UP_AFTER_UPSTREAM_CHANGE",
                  "STALE_BUT_ACTIONABLE",
                  "NO_CLEAR_CONTRIBUTION"
                ]
              },
              "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
              "reason": {"type": "string", "minLength": 1},
              "evidenceFreshness": {
                "type": "object",
                "additionalProperties": false,
                "required": ["state", "modifiedAt", "ageDays"],
                "properties": {
                  "state": {"type": "string", "enum": ["fresh", "recent", "stale", "unknown"]},
                  "modifiedAt": {"type": ["string", "null"]},
                  "ageDays": {"type": ["integer", "null"]}
                }
              },
              "sourceCoverage": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "trac_ticket",
                  "trac_keywords_status_component",
                  "public_patch_or_attachment",
                  "wordpress_develop_pr",
                  "public_pr_discussion_or_review",
                  "changed_files_or_diff",
                  "public_test_or_ci_evidence",
                  "related_or_referenced_ticket"
                ],
                "properties": {
                  "trac_ticket": {"type": "boolean"},
                  "trac_keywords_status_component": {"type": "boolean"},
                  "public_patch_or_attachment": {"type": "boolean"},
                  "wordpress_develop_pr": {"type": "boolean"},
                  "public_pr_discussion_or_review": {"type": "boolean"},
                  "changed_files_or_diff": {"type": "boolean"},
                  "public_test_or_ci_evidence": {"type": "boolean"},
                  "related_or_referenced_ticket": {"type": "boolean"}
                }
              },
              "expectedContributionType": {"type": "string"},
              "contributionHypothesis": {"type": "string"},
              "requiredEvidenceProfiles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "visualEvidenceRelevance": {"type": "string", "enum": ["required", "useful", "not-relevant"]},
              "relevantSkills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "upstreamFreshness": {"type": "string", "enum": ["fresh", "recent", "stale", "unknown"]},
              "duplicationRisk": {"type": "string", "enum": ["low", "medium", "high", "unknown"]},
              "likelyHwpChannel": {"type": "string"},
              "engineeringWeight": {"type": "string", "enum": ["small", "medium", "large"]},
              "screenshotCandidate": {"type": "boolean"},
              "backendOnlyCandidate": {"type": "boolean"},
              "missingPatchHeadBase": {"type": "boolean"},
              "eligibilityState": {"type": "string", "enum": ["eligible", "requires-upstream-validation", "blocked"]},
              "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
            }
          }
        }
      }
    },
    "verifiedContributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ticketId",
          "opportunityKey",
          "publicUrl",
          "contributionType",
          "testedHeadSha",
          "testedBaseSha",
          "verifiedAt",
          "lifecycleState"
        ],
        "properties": {
          "ticketId": {"type": "string", "pattern": "^[0-9]+$"},
          "opportunityKey": {"type": "string", "pattern": "^core-trac:[0-9]+$"},
          "publicUrl": {"type": "string", "pattern": "^https://(core\\.trac\\.wordpress\\.org|github\\.com)/.+$"},
          "contributionType": {
            "enum": [
              "NEW_FINDING",
              "INDEPENDENT_CONFIRMATION",
              "EXTENDED_EVIDENCE",
              "RETEST_CONFIRMATION"
            ]
          },
          "testedHeadSha": {"type": "string", "pattern": "^([0-9a-f]{40})?$"},
          "testedBaseSha": {"type": "string", "pattern": "^([0-9a-f]{40})?$"},
          "verifiedAt": {"type": "string", "minLength": 19},
          "lifecycleState": {"enum": ["PUBLIC_DELIVERY_VERIFIED", "UPSTREAM_ACCEPTED", "FOLLOWUP_REQUIRED"]},
          "changeset": {"type": "string", "pattern": "^[0-9]+$"},
          "props": {"type": "boolean"}
        }
      }
    }
  }
}

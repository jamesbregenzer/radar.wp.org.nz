{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar.wp.org.nz/schemas/raw-acquisition.v1.schema.json",
  "title": "Radar WordPress raw acquisition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "acquisitionId", "sourceUrl", "retrievedAt", "httpStatus", "mediaType", "etag", "lastModified", "byteLength", "rawSha256", "rawArtifact", "pagination"],
  "properties": {
    "schema": {"const": "wordpress.raw-acquisition.v1"},
    "version": {"const": 1},
    "acquisitionId": {"type": "string", "pattern": "raw-acquisition-v1-[0-9a-f]{24}"},
    "sourceUrl": {"type": "string", "minLength": 8},
    "retrievedAt": {"type": "string", "minLength": 20},
    "httpStatus": {"const": 200},
    "mediaType": {"type": ["string", "null"]},
    "etag": {"type": ["string", "null"]},
    "lastModified": {"type": ["string", "null"]},
    "byteLength": {"type": "integer"},
    "rawSha256": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "rawArtifact": {"type": "string", "minLength": 1},
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nextPagePresent", "total", "totalPages"],
      "properties": {
        "nextPagePresent": {"type": "boolean"},
        "total": {"type": ["integer", "null"]},
        "totalPages": {"type": ["integer", "null"]}
      }
    }
  }
}

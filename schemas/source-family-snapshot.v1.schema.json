{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radar.wp.org.nz/schemas/source-family-snapshot.v1.schema.json",
  "title": "Radar source family snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "sourceFamily", "label", "authoritativeSource", "machineReadableAccess", "snapshotId", "sourceRevision", "observedTime", "certifiedTime", "completeness", "freshness", "recordCount", "candidateSignalCount", "canonicalHash", "scope", "limitations", "outcomeObservers", "health", "rawAcquisitions", "retrievalReceipt", "resources"],
  "properties": {
    "schema": {"const": "source-family-snapshot.v1"},
    "version": {"const": 1},
    "sourceFamily": {"type": "string", "minLength": 1},
    "label": {"type": "string", "minLength": 1},
    "authoritativeSource": {"type": "string", "minLength": 8},
    "machineReadableAccess": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 8}},
    "snapshotId": {"type": "string", "pattern": "source-family-[a-z0-9-]+-[0-9a-f]{24}"},
    "sourceRevision": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "observedTime": {"type": "string", "minLength": 20},
    "certifiedTime": {"type": "string", "minLength": 20},
    "completeness": {"enum": ["COMPLETE", "PARTIAL"]},
    "freshness": {"const": "fresh"},
    "recordCount": {"type": "integer"},
    "candidateSignalCount": {"type": "integer"},
    "canonicalHash": {"type": "string", "pattern": "[0-9a-f]{64}"},
    "scope": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "outcomeObservers": {"type": "array", "items": {"type": "string"}},
    "health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "failure"],
      "properties": {
        "state": {"const": "certified"},
        "failure": {"type": "null"}
      }
    },
    "rawAcquisitions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "retrievalReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "canonicalHash", "path"],
      "properties": {
        "receiptId": {"type": "string", "pattern": "retrieval-receipt-v1-[0-9a-f]{24}"},
        "canonicalHash": {"type": "string", "pattern": "[0-9a-f]{64}"},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resourceType", "nativeIdentity", "nativeId", "url", "title", "state", "sourceRevision", "bodyHash", "outboundLinks", "candidateSignals"],
        "properties": {
          "resourceType": {"type": "string", "minLength": 1},
          "nativeIdentity": {"type": "string", "minLength": 1},
          "nativeId": {"type": ["string", "integer"]},
          "url": {"type": "string", "minLength": 8},
          "title": {"type": "string", "minLength": 1},
          "state": {"type": "string", "minLength": 1},
          "sourceRevision": {"type": "string", "minLength": 1},
          "bodyHash": {"type": "string", "pattern": "[0-9a-f]{64}"},
          "outboundLinks": {"type": "array", "items": {"type": "string"}},
          "candidateSignals": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["familyId", "state", "confidence", "reason", "evidence"],
              "properties": {
                "familyId": {"type": "string", "minLength": 1},
                "state": {"enum": ["CLEAR_OPPORTUNITY", "POSSIBLE_OPPORTUNITY"]},
                "confidence": {"enum": ["high", "medium", "low"]},
                "reason": {"type": "string", "minLength": 1},
                "evidence": {"type": "array", "items": {"type": "string"}}
              }
            }
          }
        }
      }
    }
  }
}
